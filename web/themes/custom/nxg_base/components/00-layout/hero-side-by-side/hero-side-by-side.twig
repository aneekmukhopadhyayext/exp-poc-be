{# Define hero variant classes #}
{% set hero_base_classes = ['relative', 'h-full', 'flex'] %}

{% set image_position_classes = {
  'left': 'md:flex-row',
  'right': 'md:flex-row-reverse'
} %}

{% set hero_flex_gap_classes = {
  'large': 'gap-4 md:gap-6 xl:gap-8',
  'extra-large': 'gap-16 md:gap-24 xl:gap-32'
} %}

{% set hero_flex_direction_mobile_classes = {
  'vertical': 'flex-col',
  'vertical-reverse': 'flex-col-reverse'
} %}

{% set padding_block_start_classes = {
  '0': 'pt-0',
  '16': 'pt-4',
  '32': 'pt-6 md:pt-7 xl:pt-8',
  '64': 'pt-10 md:pt-13 xl:pt-16'
} %}

{% set padding_block_end_classes = {
  '0': 'pb-0',
  '16': 'pb-4',
  '32': 'pb-6 md:pb-7 xl:pb-8',
  '64': 'pb-10 md:pb-13 xl:pb-16'
} %}

{# Define background variant classes #}
{% set bgd_base_classes = ['absolute', 'inset-0', 'z-[-1]'] %}

{% set background_classes = {
  'primary': 'bg-primary text-primary-foreground',
  'secondary': 'bg-secondary text-secondary-foreground',
  'accent': 'bg-accent text-accent-foreground'
} %}

{# Define image variant classes #}
{% set image_base_classes = ['flex-1', 'overflow-hidden', 'rounded-none'] %}

{% set image_size_classes = {
  '2:1': 'aspect-2/1',
  '16:9': 'aspect-16/9',
  '3:2': 'aspect-3/2',
  '4:3': 'aspect-4/3',
  '1:1': 'aspect-1/1'
} %}

{% set image_radius_classes = {
  'small': 'rounded-sm',
  'large': 'rounded-xl md:rounded-2xl',
  'extra-large': 'rounded-[24px] md:rounded-[32px]'
} %}

{# Build hero classes #}
{% set hero_class_list = hero_base_classes|merge([
  image_position_classes[image_position] ?: '',
  hero_flex_gap_classes[hero_flex_gap|default('large')] ?: '',
  hero_flex_direction_mobile_classes[hero_flex_direction_mobile] ?: '',
  padding_block_start_classes[padding_block_start] ?: '',
  padding_block_end_classes[padding_block_end] ?: ''
]) %}

{% set hero_classes = hero_class_list|join(' ')|trim %}

{# Build background classes #}
{% set bgd_class_list = bgd_base_classes|merge([
  background_classes[background] ?: ''
]) %}

{% set bgd_classes = bgd_class_list|join(' ')|trim %}

{# Build image classes #}
{% set image_class_list = image_base_classes|merge([
  image_size_classes[image_size] ?: '',
  image_radius_classes[image_radius] ?: ''
]) %}

{% set image_classes = image_class_list|join(' ')|trim %}

<section class="{{ hero_classes }}">
  {% if background is not empty and background != 'None' %}
    <div class="{{ bgd_classes }}"></div>
  {% endif %}

  <div class="{{ image_classes }}">
    {% block hero_media %}
      {% include 'canvas:image' ignore missing with {
        src: media.src,
        alt: media.alt,
        class: 'object-cover w-full h-full',
        width: media.width,
        height: media.height,
        sizes: '50vw'
      } only %}
    {% endblock %}
  </div>
  <div class="flex flex-1 flex-col gap-6">
    {% block hero_content %}
      {% block hero_slot %}

      {% endblock %}
    {% endblock %}
  </div>
</section>
